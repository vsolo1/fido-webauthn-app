{
  "name": "homelab-fido-app",
  "version": "1.0.0",
  "description": "Full-stack FIDO2/WebAuthn passwordless login for the home lab",
  "main": "server.js",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node server.js",
    "dev": "RP_ID=localhost ORIGIN=http://localhost:3000 SESSION_SECRET=dev-only-secret node --watch server.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^13.1.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1"
  }
}
